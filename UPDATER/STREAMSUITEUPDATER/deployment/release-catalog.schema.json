{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stream Suite Release Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "defaultChannel", "releases"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "defaultChannel": { "type": "string", "enum": ["stable", "beta"] },
    "releases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "update-manifest.schema.json" }
    }
  }
}
