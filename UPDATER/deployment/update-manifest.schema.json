{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/babydreamsy94/STREAM-SUITE/update-manifest.schema.json",
  "title": "Stream Suite Update Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "suiteVersion",
    "displayVersion",
    "releaseName",
    "releaseDate",
    "channel",
    "streamerBot",
    "platforms",
    "package",
    "installation",
    "releaseNotes",
    "releaseNotesUrl",
    "breakingChanges"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "suiteVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "displayVersion": { "type": "string", "minLength": 1 },
    "releaseName": { "type": "string", "minLength": 1 },
    "releaseDate": { "type": "string", "format": "date" },
    "channel": { "type": "string", "enum": ["stable", "beta"] },
    "streamerBot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimumVersion", "testedVersion"],
      "properties": {
        "minimumVersion": { "type": "string" },
        "testedVersion": { "type": "string" }
      }
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "status": {
            "type": "string",
            "enum": ["verified", "experimental", "not-verified", "unsupported"]
          },
          "note": { "type": "string" }
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "url", "sha256", "sizeBytes"],
      "properties": {
        "fileName": { "type": "string", "pattern": "\\.zip$" },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "sizeBytes": { "type": "integer", "minimum": 1 }
      }
    },
    "installation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "guideFile", "requiresBackup"],
      "properties": {
        "mode": { "const": "guided-import" },
        "guideFile": { "type": "string", "minLength": 1 },
        "requiresBackup": { "type": "boolean" }
      }
    },
    "releaseNotes": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      ]
    },
    "releaseNotesUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "breakingChanges": { "type": "boolean" },
    "notice": { "type": "string" }
  }
}
